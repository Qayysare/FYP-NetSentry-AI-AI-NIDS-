# Required for Waitress/LAN deployment. Set a unique long random value; never commit the real value.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
TSHARK_PATH=D:\Degree\FYP\Wireshark\tshark.exe
MAX_PCAP_UPLOAD_BYTES=20971520
MAX_PCAP_PACKETS=500
# DEPLOYMENT ENVIRONMENT
# FYP VM DEMO: set the TShark interface receiving authorised virtual-lab traffic.
# REAL COMPANY DEPLOYMENT: connect the monitoring NIC to an authorised SPAN/mirror
# destination port, then set its TShark interface ID. The AI model/pipeline do not change.
AI_NIDS_AUTO_MONITORING=false
AI_NIDS_MONITOR_INTERFACE=
SESSION_COOKIE_SECURE=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_nids
DB_USER=root
DB_PASSWORD=
